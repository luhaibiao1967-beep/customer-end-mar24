# Copy to ".env.local" — Supabase Dashboard → Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api

# --- Recommended for this Vite app ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Must be Legacy anon JWT (eyJ...) for Edge Functions (functions.invoke). Using sb_publishable_* → 401.
VITE_SUPABASE_ANON_KEY=eyJ...

# --- Optional: Next.js–style names (supported if you paste from another repo) ---
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...  (if you use JWT anon instead)

# Optional aliases
# VITE_SUPABASE_URL_CLOUD=
# VITE_SUPABASE_ANON_KEY_CLOUD=

# --- Google Maps (Branch selection / register address) ---
# Cloud Console → APIs: enable "Maps JavaScript API" + "Places API", set HTTP referrer restrictions.
# VITE_GOOGLE_MAPS_API_KEY=AIza...

# --- Local Supabase CLI only ---
# VITE_SUPABASE_MODE=local
# VITE_SUPABASE_URL_LOCAL=/supabase
# VITE_SUPABASE_ANON_KEY_LOCAL=
